# SLS Powder API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sls_powder
DB_USER=sls_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_STRING
